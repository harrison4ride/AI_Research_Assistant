# Copy this file to `.env` (same directory) and fill in the values.
# `.env` is git-ignored — never commit real keys.

# Directory for the SQLite database and uploaded PDFs.
# Relative paths are resolved against backend/. Default: backend/data
# DATA_DIR=data

# --- Paper search (optional) ---
# OpenAlex: an email puts requests in the polite pool; a free API key raises
# the daily quota (https://openalex.org/settings/api).
# OPENALEX_EMAIL=you@example.com
# OPENALEX_API_KEY=
