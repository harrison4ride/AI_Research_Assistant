# Copy this file to `.env` (same directory) and fill in the values, or run
# ./scripts/setup.sh, which does it for you. `.env` is git-ignored; never commit
# real keys. Variables set in your shell override the values here.

# Directory for the SQLite database and uploaded PDFs.
# Relative paths are resolved against backend/. Default: backend/data
# DATA_DIR=data

# --- Paper search (optional) ---
# OpenAlex: an email puts requests in the polite pool; a free API key raises
# the daily quota (https://openalex.org/settings/api).
# OPENALEX_EMAIL=you@example.com
# OPENALEX_API_KEY=

# --- PDF handling ---
# Maximum size for uploaded or downloaded PDFs, in megabytes.
# MAX_PDF_MB=50

# --- LLM (summaries, Q&A, and reading metadata from uploaded PDFs) ---
# claude-code (default): use the Claude Code CLI installed on this machine with
#   your own Claude Code login. No API key needed. Install Claude Code from
#   https://claude.com/claude-code and run `claude` once to log in.
# api: call the Anthropic API with ANTHROPIC_API_KEY below.
# LLM_PROVIDER=claude-code
# Claude Code model alias or name (opus, sonnet, ...); "default" uses Claude Code's own default.
# CLAUDE_CODE_MODEL=opus
# Path to the `claude` command, if it is not on your PATH.
# CLAUDE_CODE_PATH=

# Only for LLM_PROVIDER=api. Get a key at https://console.anthropic.com/.
ANTHROPIC_API_KEY=
# Model for LLM_PROVIDER=api.
# LLM_MODEL=claude-opus-5
# Thinking effort for both providers (low | medium | high | xhigh | max).
# LLM_EFFORT=medium
# Max characters of paper text sent to the model (~4 characters per token).
# LLM_MAX_PAPER_CHARS=400000
# Max tokens (thinking + answer) per summary or answer (LLM_PROVIDER=api only).
# LLM_MAX_TOKENS=32000
# Earlier Q&A messages sent with each new question.
# LLM_HISTORY_MESSAGES=20
# Alternative API endpoint (e.g. a proxy); leave unset for the Anthropic API (LLM_PROVIDER=api only).
# ANTHROPIC_BASE_URL=
# Use the LLM to extract title/authors/year/abstract from uploaded PDFs.
# LLM_EXTRACT_METADATA=true

# --- Serving ---
# Set to false to serve only the API (`make dev` does this; Vite serves the UI).
# SERVE_FRONTEND=true
# Built frontend that the backend serves. Relative paths are resolved against backend/.
# FRONTEND_DIST=../frontend/dist
